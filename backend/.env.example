# Local development. setup.py writes a fresh secret automatically.
DEBUG=true
DJANGO_SECRET_KEY=development-only-change-before-deployment
ALLOWED_HOSTS=localhost,127.0.0.1,backend
COOKIE_SECURE=false
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
MONGO_URI=mongodb://localhost:27017
MONGO_DB=skillentra

# none = curated/checklist fallback. Choose ollama or gemini to enable AI.
AI_PROVIDER=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
GEMINI_API_KEY=
# Set to a currently available generateContent-compatible model from AI Studio.
GEMINI_MODEL=

# Optional independent provider/model per operation. Empty model overrides must be omitted.
# RESUME_AI_PROVIDER=gemini
# RESUME_AI_MODEL=your-available-model
# INTERVIEW_AI_PROVIDER=ollama
# INTERVIEW_AI_MODEL=qwen2.5:7b
# EXAM_AI_PROVIDER=ollama
# EXAM_AI_MODEL=qwen2.5:7b
# CODING_AI_PROVIDER=ollama
# CODING_AI_MODEL=qwen2.5-coder:7b

# A self-hosted or hosted isolated Judge0 CE endpoint is required to execute code.
# Do not point this at an arbitrary host-side Python/Node executor.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=
# Verify these IDs against GET /languages on YOUR Judge0 instance.
JUDGE0_PYTHON_ID=71
JUDGE0_JAVASCRIPT_ID=63
JUDGE0_JAVA_ID=62
JUDGE0_CPP_ID=54
